rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;  // borrado solo vía Cloud Function (GDPR)
    }

    match /letters/{letterId} {
      // Crear: solo autenticado y como autor, solo en draft
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';

      // Leer: el autor siempre puede leer METADATOS. El body de una carta
      // sealed se protege a nivel de aplicación (no se renderiza) y el
      // acceso de destinatarios externos va vía endpoint con openToken.
      allow read: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // Actualizar: solo el autor, y solo si sigue en draft (incluye la
      // transición draft→sealed), o transición sealed→cancelled sin tocar
      // el contenido.
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && (
          resource.data.status == 'draft'
          || (resource.data.status == 'sealed'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.body == resource.data.body)
        );

      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && resource.data.status == 'draft';
    }
  }
}
